# Transparency and visual settings
background_opacity 0.7
enable_background_blur no

# Disable the warning prompt when closing the window
confirm_os_window_close 0


# BEGIN_KITTY_THEME
# Rosé Pine
include current-theme.conf
# END_KITTY_THEME

# Use the exact family name found in fc-list
font_family      Minecraft
# Explicitly map bold/italic to the available styles to prevent fallback
bold_font        Minecraft Bold
italic_font      Minecraft
bold_italic_font Minecraft Bold
# Ensure font size is an integer for pixel fonts
font_size        9.0

shell /usr/bin/fish
