 {
    /* Primary font is Minecraft, fallback to Nerd Font for icons */
    font-family: "Minecraft", "JetBrainsMono Nerd Font", "Font Awesome 6 Free", monospace;
    font-size: 12px;
    color: #ffffff;
    border: none;
    border-radius: 0;
}

window#waybar {
    background-color: rgba(30, 30, 46, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

#workspaces button {
    padding: 0 5px;
    color: #ffffff;
    background: transparent;
}

#workspaces button.active {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

#custom-arch,
#clock,
#network,
#bluetooth,
#pulseaudio,
#backlight,
#battery,
#workspaces {
    padding: 0 8px;
    margin: 4px 2px;
    color: #ffffff;
    background: transparent;
}

/* Dim muted or disconnected states slightly for contrast */
#network.disconnected,
#pulseaudio.muted {
    color: rgba(255, 255, 255, 0.5);
}
